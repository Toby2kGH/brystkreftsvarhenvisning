{
  "name": "brystkreftsvarhenvisning",
  "version": "1.0.0",
  "description": "Klinisk beslutningsstøtte for brystkreftbehandling - CDK4/6-inhibitorvalg basert på BPM+ Health-arkitektur",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ server/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "fhirclient": "^2.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "eslint": "^8.56.0"
  }
}
